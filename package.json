    "@types/node": "^26.6.6",
    "typescript": "~5.7.3",
    "vite": "^6.0.7",
    "vite-plugin-solid": "^2.11.16",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/filesystem": "^7.1.9",
    "@capacitor/local-notifications": "^7.0.0",
    "@capacitor/share": "^7.0.4",
    "@capacitor/status-bar": "^7.0.0",
    "hash-wasm": "^4.13.0",
    "solid-js": "^1.9.19"
